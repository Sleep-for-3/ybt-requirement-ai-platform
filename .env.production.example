# Production environment template for the Linux Docker Compose topology.
#
# Usage:
#   1. copy this file to ``.env`` next to ``docker-compose.yml`` (never commit it);
#   2. replace every ``change-me`` value with a real secret;
#   3. run ``docker compose up -d`` - the one-shot ``migrate`` service applies the
#      schema and api/worker/beat wait for it to complete.
#
# This file is documentation only: docker-compose.yml never references it.

# ---------------------------------------------------------------------------
# Core runtime
# ---------------------------------------------------------------------------
ENVIRONMENT=production
AUTH_MODE=required
DEBUG=false
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-app-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-key
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=https://your-domain.example
# Only enable when a trusted reverse proxy sets X-Forwarded-* headers.
TRUST_PROXY_HEADERS=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REQUEST_RATE_LIMIT_PER_MINUTE=600

# ---------------------------------------------------------------------------
# PostgreSQL (compose builds DATABASE_URL from PRODUCTION_DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=ybt
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ybt
PRODUCTION_DATABASE_URL=postgresql+psycopg://ybt:change-me-postgres-password@postgres:5432/ybt
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---------------------------------------------------------------------------
# Task queue (Redis + Celery worker + Celery beat)
# ---------------------------------------------------------------------------
TASK_QUEUE_PROVIDER=celery
TASK_QUEUE_INLINE_MAX_JOBS=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# local -> backend_storage volume, s3 -> S3/MinIO compatible endpoint
STORAGE_PROVIDER=local
STORAGE_DIR=/app/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key

# ---------------------------------------------------------------------------
# Vector store and embeddings
# ---------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=milvus
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_PREFIX=ybt_semantic
# Credentials for the bundled Milvus/MinIO profile (docker compose --profile milvus).
MILVUS_MINIO_ROOT_USER=change-me-milvus-minio-user
MILVUS_MINIO_ROOT_PASSWORD=change-me-milvus-minio-password
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY_ENV_NAME=
EMBEDDING_DIMENSION=0

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# mock | openai | openai_compatible | local_vllm | local_ollama_compatible
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY_ENV_NAME=
# Ordered fallback models replayed when the primary endpoint answers with a
# model-level outage (HTTP 404, or 400 code=model_not_found).  Leave empty to
# disable.  LLM_FALLBACK_BASE_URL / LLM_FALLBACK_API_KEY_ENV_NAME let the
# fallback point at a second provider -- for example a domestic model:
#   LLM_FALLBACK_MODELS=deepseek-chat
#   LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
#   LLM_FALLBACK_API_KEY_ENV_NAME=DEEPSEEK_API_KEY
LLM_FALLBACK_MODELS=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY_ENV_NAME=
# Provider round-trip budget for background generation (seconds, 1-180).
LLM_TIMEOUT_SECONDS=120
# Budget for synchronous, user-facing model calls (knowledge Q&A and the
# connection test).  Their answers degrade to evidence-only when this budget is
# exhausted, so keep it below the reverse-proxy / browser request timeout.
LLM_INTERACTIVE_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# Uploads, lineage repository polling, data sources
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
LINEAGE_GIT_ENABLED=true
LINEAGE_GIT_ALLOWED_HOSTS=github.com,gitee.com
LINEAGE_GIT_ALLOWED_LOCAL_ROOTS=
LINEAGE_REPOSITORY_MAX_BYTES=524288000
LINEAGE_REPOSITORY_MAX_FILE_COUNT=10000
SAFE_SQL_DEFAULT_LIMIT=100
SAFE_SQL_MAX_LIMIT=1000
SAFE_SQL_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Health checks
# ---------------------------------------------------------------------------
HEALTH_DETAILS_PUBLIC=false
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
DISK_FREE_MIN_BYTES=104857600

# ---------------------------------------------------------------------------
# Host bindings (compose publishes the API/frontend on these addresses)
# ---------------------------------------------------------------------------
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ---------------------------------------------------------------------------
# Release tagging (docker-compose.server.yml)
# ---------------------------------------------------------------------------
# 不可变发布标签；后端/前端镜像都打成 ybt-backend:<tag> 与 ybt-frontend:<tag>。
# 推荐使用 UTC 时间戳或 Git 短 SHA，回滚时把该值改回上一版即可。
YBT_RELEASE_TAG=change-me-20260101-000000
