# Copy to .env for Docker Compose production. Never commit the populated file.
POSTGRES_USER=ybt
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=ybt
PRODUCTION_DATABASE_URL=postgresql+psycopg://ybt:replace-with-url-encoded-password@postgres:5432/ybt
APP_SECRET_KEY=replace-with-a-random-64-character-value
JWT_SECRET_KEY=replace-with-a-different-random-64-character-value
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
